# 这些值都已作为公开默认值写在 vite.config.ts 里，**不建 .env 也能直接构建**。
# 只有需要覆盖时才复制本文件为 .env（.env 已被 .gitignore 排除）。

# Web 版 API 地址（相对路径时由部署方反代到自建 API）
VUE_APP_NETEASE_API_URL=/api

# 桌面版生产环境 API 地址（经本地 27232 服务反代到内嵌 API）
VUE_APP_ELECTRON_API_URL=/api

# 桌面版开发环境 API 地址。
# 保持相对路径 /api：开发服务器会把它同源代理到内嵌 API(10754)。
# ⚠ 不要改回 http://127.0.0.1:10754 —— 渲染进程已开启 webSecurity，
#   跨源直连会被拦截。
VUE_APP_ELECTRON_API_URL_DEV=/api

# Last.fm 客户端密钥（公开值，会打进客户端产物）
VUE_APP_LASTFM_API_KEY=09c55292403d961aa517ff7f5e8a3d9c
VUE_APP_LASTFM_API_SHARED_SECRET=307c9fda32b3904e53654baff215cb67

# 开发服务器端口
DEV_SERVER_PORT=20201
