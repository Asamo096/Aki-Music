{
  "name": "aki-music",
  "version": "0.1.0",
  "private": true,
  "description": "Aki Music — 基于 YesPlayMusic 二次开发的第三方网易云音乐播放器",
  "author": "Asamo096<asamo096@outlook.com>",
  "license": "AGPL-3.0-or-later",
  "main": "dist-electron/background.js",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "vite build",
    "build:electron": "vite build --mode electron && node scripts/build-main.mjs",
    "build:main": "node scripts/build-main.mjs",
    "electron:build": "pnpm build:electron && electron-builder --config electron-builder.yml",
    "electron:build:dir": "pnpm build:electron && electron-builder --config electron-builder.yml --dir",
    "electron:build:win": "pnpm build:electron && electron-builder --config electron-builder.yml --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .js,.vue src",
    "prettier": "prettier --write ./src",
    "icons": "node scripts/generate-icons.mjs",
    "netease_api:run": "npx @neteaseapireborn/api"
  },
  "dependencies": {
    "@neteaseapireborn/api": "4.29.7",
    "@unblockneteasemusic/rust-napi": "^0.4.0",
    "axios": "^0.26.1",
    "change-case": "^4.1.2",
    "cli-color": "^2.0.0",
    "color": "^4.2.3",
    "crypto-js": "^4.0.0",
    "dayjs": "^1.8.36",
    "dbus-next": "^0.9.2",
    "dexie": "^3.0.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-store": "^8.0.1",
    "electron-updater": "^6.8.9",
    "express": "^4.17.1",
    "express-fileupload": "^1.2.0",
    "express-http-proxy": "^1.6.2",
    "howler": "^2.2.3",
    "js-cookie": "^2.2.1",
    "jsbi": "^4.1.0",
    "lodash": "^4.17.20",
    "md5": "^2.3.0",
    "mpris-service": "^2.1.2",
    "node-vibrant": "^3.2.1-alpha.1",
    "nprogress": "^0.2.0",
    "pac-proxy-agent": "^4.1.0",
    "plyr": "^3.6.2",
    "qrcode": "^1.4.4",
    "tunnel": "^0.0.6",
    "vscode-codicons": "^0.0.17",
    "vue": "^2.7.16",
    "vue-clipboard2": "^0.3.1",
    "vue-i18n": "^8.22.0",
    "vue-router": "^3.4.3",
    "vue-slider-component": "^3.2.5",
    "vuex": "^3.4.0",
    "x11": "^2.3.0"
  },
  "devDependencies": {
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "babel-eslint": "^10.1.0",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^6.7.2",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-vue": "^7.9.0",
    "husky": "^4.3.0",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "prettier": "2.5.1",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true
    },
    "extends": [
      "plugin:vue/essential",
      "plugin:vue/recommended",
      "plugin:prettier/recommended",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "globals": {
      "ipcRenderer": "off"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npm run prettier"
    }
  }
}
